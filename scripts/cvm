#!/usr/bin/env bash
# cvm — Apple container VM lifecycle at microVM speed
# Boot 0.72s · warm exec 0.04s · teardown 0.18s (Apple Silicon, cached image)
#
# USAGE
#   cvm run [-d] [-c CPUS] [-m MEM] [-n] [-i IMG] NAME -- CMD...   one-shot task (auto-delete)
#   cvm pool start [-c CPUS] [-m MEM] [-i IMG] NAME                 warm-pool VM (zero boot later)
#   cvm exec NAME -- CMD...                                         run inside a pool VM (~40ms)
#   cvm kill NAME                                                   fast teardown (0.18s)
#   cvm cp NAME:/path /host/path                                    copy artifacts out of a VM
#   cvm list                                                        list VMs + host footprint
#
# FLAGS
#   -d        detached one-shot: return immediately, poll until auto-deleted
#   -c CPUS   vCPUs (default 2)      -m MEM   memory (default 4g)
#   -i IMG    image (default ubuntu:24.04)    -n   air-gap: --network none --no-dns
set -euo pipefail

DEFAULT_IMG="ubuntu:24.04"
DEFAULT_CPUS=2
DEFAULT_MEM="4g"

usage() { sed -n '3,15p' "$0" | sed 's/^# //'; exit "${1:-0}"; }
now() { python3 -c 'import time; print(time.time())'; }
elapsed() { python3 -c "print(f'$1 {float($2)-float($3):.2f}s')"; }

# ---- one-shot: boot, run, auto-delete (0.7s cycle) ----
cmd_run() {
  local detach="" cpus="$DEFAULT_CPUS" mem="$DEFAULT_MEM" img="$DEFAULT_IMG" net="" name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d) detach=1; shift ;;
      -c) cpus="$2"; shift 2 ;;
      -m) mem="$2"; shift 2 ;;
      -i) img="$2"; shift 2 ;;
      -n) net="--network none --no-dns"; shift ;;
      --) shift; break ;;
      -h|--help) usage ;;
      *) name="$1"; shift; break ;;
    esac
  done
  [[ -z "$name" ]] && { echo "cvm run: NAME required" >&2; usage 1; }
  [[ "${1:-}" == "--" ]] && shift   # strip separator — container CLI has no --
  local cmd=("$@"); [[ ${#cmd[@]} -eq 0 ]] && cmd=(bash)

  local t0; t0=$(now)
  if [[ -n "$detach" ]]; then
    container run -d --rm --name "$name" $net --cpus "$cpus" --memory "$mem" "$img" "${cmd[@]}"
    while container list 2>/dev/null | awk '{print $1}' | grep -qx "$name"; do sleep 0.05; done
  else
    container run --rm --name "$name" $net --cpus "$cpus" --memory "$mem" "$img" "${cmd[@]}"
  fi
  local t1; t1=$(now)
  elapsed "cvm: cycle ($name)" "$t1" "$t0"
}

# ---- warm pool: long-lived VM, exec in ~40ms ----
cmd_pool() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    start)
      local cpus="$DEFAULT_CPUS" mem="$DEFAULT_MEM" img="$DEFAULT_IMG" net="" name=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          -c) cpus="$2"; shift 2 ;; -m) mem="$2"; shift 2 ;;
          -i) img="$2"; shift 2 ;; -n) net="--network none --no-dns"; shift ;;
          *) name="$1"; shift; break ;;
        esac
      done
      [[ -z "$name" ]] && { echo "cvm pool start: NAME required" >&2; usage 1; }
      container run -d --name "$name" $net --cpus "$cpus" --memory "$mem" "$img" sleep 86400
      echo "cvm: pool '$name' ready (warm exec ≈ 0.04s)"
      ;;
    *)
      echo "cvm pool: use 'start'" >&2; usage 1 ;;
  esac
}

cmd_exec() {
  local name="" net="" 
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      *) name="$1"; shift; break ;;
    esac
  done
  [[ -z "$name" ]] && { echo "cvm exec: NAME required" >&2; usage 1; }
  [[ "${1:-}" == "--" ]] && shift   # strip separator
  if ! container list 2>/dev/null | awk '{print $1}' | grep -qx "$name"; then
    echo "cvm: '$name' not running — start a pool first (cvm pool start $name)" >&2; exit 1
  fi
  container exec "$name" "$@"
}

cmd_kill() {
  local name="${1:-}"
  [[ -z "$name" ]] && { echo "cvm kill: NAME required" >&2; usage 1; }
  local t0; t0=$(now)
  container kill "$name" >/dev/null 2>&1 || true
  container rm -f "$name" >/dev/null 2>&1 || true
  local t1; t1=$(now)
  elapsed "cvm: teardown ($name)" "$t1" "$t0"
}

cmd_cp() { container cp "$1" "$2"; }
cmd_list() {
  container list 2>/dev/null
  echo "--- host footprint ---"
  du -sh "$HOME/Library/Application Support/com.apple.container/containers/"*/ 2>/dev/null || true
}

case "${1:-}" in
  run)   shift; cmd_run "$@" ;;
  pool)  shift; cmd_pool "$@" ;;
  exec)  shift; cmd_exec "$@" ;;
  kill)  shift; cmd_kill "$@" ;;
  cp)    shift; cmd_cp "$@" ;;
  list)  shift; cmd_list "$@" ;;
  -h|--help) usage ;;
  *) usage 1 ;;
esac
